uns:marche.accordCadre a owl:DatatypeProperty ;
    rdfs:label "marche.accordCadre" ;
    rdfs:comment "Identifiant de l'accord-cadre. Pour un marché subséquent, le numéro d'identification de marché public relevant de la technique d'achat accord-cadre. Exemples : 1234 ou C123_456-98777nz"@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso <http://data.europa.eu/a4g/ontology#FrameworkAgreement> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.attributionAvance a owl:DatatypeProperty ;
    rdfs:label "marche.attributionAvance" ;
    rdfs:comment "Attribution d'une avance. Une avance a été attribuée au titulaire principal du marché public"@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.ccag a owl:DatatypeProperty ;
    rdfs:label "marche.ccag" ;
    rdfs:comment "CCAG de référence. Cahiers des clauses administratives générales de référence du marché public"@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.codeCPV a owl:DatatypeProperty ;
    rdfs:label "marche.codeCPV" ;
    rdfs:comment "Code CPV. Nomenclature européenne permettant d'identifier les catégories de biens et de service faisant l'objet du marché (http://simap.ted.europa.eu/web/simap/cpv). Exemple: 45112500 (même si toléré, il préférable d'omettre le caractère de contrôle (-9))"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasMainClassification> ;
    uns:domaine unsref:cpv ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.considerationEnvironnementale a owl:DatatypeProperty ;
    rdfs:label "marche.considerationEnvironnementale" ;
    rdfs:comment "Considérations environnementales. Les considérations environnementales du marché public"@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso <http://data.europa.eu/a4g/ontology#GreenProcurement> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.considerationSociale a owl:DatatypeProperty ;
    rdfs:label "marche.considerationSociale" ;
    rdfs:comment "Considérations sociales. Les considérations sociales du marché public"@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso <http://data.europa.eu/a4g/ontology#SocialProcurement> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.dateNotification a owl:DatatypeProperty ;
    rdfs:label "marche.dateNotification" ;
    rdfs:comment "Date de la notification du marché. Date à laquelle le marché a été notifié au(x) titulaire(s), au format AAAA-MM-JJ."@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso "epo:hasContractConclusionDate (à confirmer)" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.datePublicationDonnees a owl:DatatypeProperty ;
    rdfs:label "marche.datePublicationDonnees" ;
    rdfs:comment "Date de la publication des données essentielles du marché. Date à laquelle les données essentielles du marché décrit ont été publiées sur data.gouv.fr pour la première fois. Cette date n'est donc pas mise à jour en cas de modification du marché."@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasPublicationDate> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.dureeMois a owl:DatatypeProperty ;
    rdfs:label "marche.dureeMois" ;
    rdfs:comment "Durée initiale du marché. La durée du marché, en mois, telle que définie au moment de la publication des données. Si une fois les données initiales du marché publiées une modification de la durée du marché intervient, elle doit être retranscrite via un objet enfant de Modifications et la propriété Duree initiale ne doit pas être modifiée. La durée initale du marché comprend la durée des tranches et reconductions potentielles."@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#definesContractDuration> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.formePrix a owl:DatatypeProperty ;
    rdfs:label "marche.formePrix" ;
    rdfs:comment "Forme du prix"@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.identifiant a owl:DatatypeProperty ;
    rdfs:label "marche.identifiant" ;
    rdfs:comment "Identifiant de marché. Exemples : 1234 ou C123_456-98777nz"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasInternalIdentifier> ;
    uns:domaine unsref:marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.innovant a owl:DatatypeProperty ;
    rdfs:label "marche.innovant" ;
    rdfs:comment "Marché innovant. Marché public comportant des travaux, services ou fournitures innovants"@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso <http://data.europa.eu/a4g/ontology#InnovativeProcurement> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.lieuExecution.code a owl:DatatypeProperty ;
    rdfs:label "marche.lieuExecution.code" ;
    rdfs:comment "Code du lieu d'exécution. Code du lieu d'exécution (code postal, commune, canton, arrondissement, département, région, pays). Les codes INSEE sont à privilégier aux dépens du code postal. Exemple : 2B002"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#definesSpecificPlaceOfPerformance> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.lieuExecution.typeCode a owl:DatatypeProperty ;
    rdfs:label "marche.lieuExecution.typeCode" ;
    rdfs:comment "Type de code du lieu d'exécution. Le type de code utilisé pour désigner le lieu d'exécution. Hormis le « Code postal », les codes sont des codes géographiques gérés par l'INSEE (http://www.insee.fr/fr/methodes/nomenclatures/cog/default.asp)"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#definesSpecificPlaceOfPerformance> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.modaliteExecution a owl:DatatypeProperty ;
    rdfs:label "marche.modaliteExecution" ;
    rdfs:comment "modalités d'exécution. la ou les modalités d'exécution du marché public"@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.montant a owl:DatatypeProperty ;
    rdfs:label "marche.montant" ;
    rdfs:comment "Montant forfaitaire ou estimé maximum HT"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasContractValue> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.nature a owl:DatatypeProperty ;
    rdfs:label "marche.nature" ;
    rdfs:comment "Nature du marché. La nature du marché."@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.objet a owl:DatatypeProperty ;
    rdfs:label "marche.objet" ;
    rdfs:comment "Objet du marché. Description synthétique de l'objet du marché ou du lot."@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasPurpose> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.offresRecues a owl:DatatypeProperty ;
    rdfs:label "marche.offresRecues" ;
    rdfs:comment "Nombre d'offres reçues. Nombre d'offres reçues par l'acheteur de la part des soumissionnaires. Comprend aussi les offres irrégulières, inacceptables, inappropriées et anormalement basses."@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso "epo:SubmissionStatisticalInformation / epo:hasReceivedTenders" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.origineFrance a owl:DatatypeProperty ;
    rdfs:label "marche.origineFrance" ;
    rdfs:comment "Part des produits français. Pour les marchés de fournitures de denrées alimentaires, de véhicules, de produits de santé et d'habillement, selon la liste annexée à l'arrêté, la part des produits français avec laquelle le marché sera exécuté. 0.2 = 20 % de la part des produits sont français. Cette valeur ne peut pas être supérieure à la valeur d'origineUE."@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso "epo:hasCountryOfOrigin (à confirmer)" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.origineUE a owl:DatatypeProperty ;
    rdfs:label "marche.origineUE" ;
    rdfs:comment "Part des produits provenant de l'Union européenne. Pour les marchés de fournitures de denrées alimentaires, de véhicules, de produits de santé et d'habillement, selon la liste annexée à l'arrêté, la part des produits issus de l'Union européenne avec laquelle le marché sera exécuté. 0.2 = 20 % de la part des produits provient de l'Union européenne. Cette valeur ne peut pas être inférieure à la valeur d'origineFrance."@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso "epo:hasCountryOfOrigin (à confirmer)" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.procedure a owl:DatatypeProperty ;
    rdfs:label "marche.procedure" ;
    rdfs:comment "Procédure de passation du marché. La procédure de passation de marché utilisée par l'acheteur"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasProcedureType> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.sousTraitanceDeclaree a owl:DatatypeProperty ;
    rdfs:label "marche.sousTraitanceDeclaree" ;
    rdfs:comment "Sous-traitance déclarée. Au moment de la notification du marché, les titulaires du marché ont déclaré s'appuyer sur un ou plusieurs sous-traitants pour ce marché public."@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#hasSubcontracting> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.tauxAvance a owl:DatatypeProperty ;
    rdfs:label "marche.tauxAvance" ;
    rdfs:comment "Taux de l'avance. Taux de l'avance attribuée au titulaire principal du marché public par rapport au montant du marché (O.1 = 10 % du montant du marché). En fonction de la valeur de attributionAvance, une valeur égale à 0 signifie qu'il y a une avance mais que le taux n'est pas connu (attributionAvance=true)."@fr ;
    rdfs:domain uns:Marche ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.technique a owl:DatatypeProperty ;
    rdfs:label "marche.technique" ;
    rdfs:comment "Technique d'achat. Liste des techniques d'achat utilisées par l'acheteur"@fr ;
    rdfs:domain uns:Marche ;
    owl:equivalentProperty <http://data.europa.eu/a4g/ontology#usesTechnique> ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.typeGroupementOperateurs a owl:DatatypeProperty ;
    rdfs:label "marche.typeGroupementOperateurs" ;
    rdfs:comment "Type de groupement d'opérateurs. Le type de groupement d'entreprises ou d'opérateurs économiques"@fr ;
    rdfs:domain uns:Marche ;
    rdfs:seeAlso "epo:OrganisationGroup / epo:hasGroupType" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

uns:marche.typePrix a owl:DatatypeProperty ;
