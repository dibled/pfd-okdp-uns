    rdfs:comment "Modifications des données du marché après leur publication initiale. Une fois les données essentielles du marché publiées, aucune modification des données n'est possible, si ce n'est l'ajout d'objets dans Modifications."@fr ;
    rdfs:domain uns:ModificationMarche ;
    rdfs:seeAlso "epo:amendsContract / epo:hasChangeDescription" ;
    uns:flux "DECP_MARCHES" ;
    uns:statut "proposé"@fr .

