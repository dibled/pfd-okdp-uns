    {
      "@id": "https://w3id.org/pfd-okdp/uns/def#marche.origineUE",
      "@type": "owl:DatatypeProperty",
      "https://w3id.org/pfd-okdp/uns/def#flux": "DECP_MARCHES",
      "https://w3id.org/pfd-okdp/uns/def#statut": {
        "@language": "fr",
        "@value": "proposé"
      },
      "rdfs:comment": {
        "@language": "fr",
        "@value": "Part des produits provenant de l'Union européenne. Pour les marchés de fournitures de denrées alimentaires, de véhicules, de produits de santé et d'habillement, selon la liste annexée à l'arrêté, la part des produits issus de l'Union européenne avec laquelle le marché sera exécuté. 0.2 = 20 % de la part des produits provient de l'Union européenne. Cette valeur ne peut pas être inférieure à la valeur d'origineFrance."
      },
      "rdfs:domain": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#Marche"
      },
      "rdfs:label": "marche.origineUE",
      "rdfs:seeAlso": "epo:hasCountryOfOrigin (à confirmer)"
    },
