    <rdfs:label>marche.accordCadre</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/pfd-okdp/uns/def#Marche"/>
    <ns1:statut xml:lang="fr">proposé</ns1:statut>
    <rdfs:comment xml:lang="fr">Identifiant de l'accord-cadre. Pour un marché subséquent, le numéro d'identification de marché public relevant de la technique d'achat accord-cadre. Exemples : 1234 ou C123_456-98777nz</rdfs:comment>
    <ns1:flux>DECP_MARCHES</ns1:flux>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/a4g/ontology#FrameworkAgreement"/>
  </rdf:Description>
