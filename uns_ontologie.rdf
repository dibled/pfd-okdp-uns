    <ns1:statut xml:lang="fr">proposé</ns1:statut>
    <rdfs:comment xml:lang="fr">Modifications des actes spéciaux de sous-traitance. Une fois les données essentielles d'un acte spécial de sous-traitance publiées dans actesSousTraitance, aucune modification des données n'est possible, si ce n'est par l'ajout d'objets dans modificationsActesSousTraitance.</rdfs:comment>
    <ns1:flux>DECP_MARCHES</ns1:flux>
    <rdfs:seeAlso>epo:amendsContract (à confirmer)</rdfs:seeAlso>
  </rdf:Description>
