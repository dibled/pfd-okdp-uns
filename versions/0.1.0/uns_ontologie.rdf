  <rdf:Description rdf:about="https://w3id.org/pfd-okdp/uns/def#marche.origineFrance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>marche.origineFrance</rdfs:label>
    <rdfs:comment xml:lang="fr">Part des produits français. Pour les marchés de fournitures de denrées alimentaires, de véhicules, de produits de santé et d'habillement, selon la liste annexée à l'arrêté, la part des produits français avec laquelle le marché sera exécuté. 0.2 = 20 % de la part des produits sont français. Cette valeur ne peut pas être supérieure à la valeur d'origineUE.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/pfd-okdp/uns/def#Marche"/>
    <rdfs:seeAlso>epo:hasCountryOfOrigin (à confirmer)</rdfs:seeAlso>
    <uns:flux>DECP_MARCHES</uns:flux>
    <uns:statut xml:lang="fr">proposé</uns:statut>
  </rdf:Description>
