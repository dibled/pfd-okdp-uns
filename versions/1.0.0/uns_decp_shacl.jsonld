        },
        {
          "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b6"
        }
      ],
      "sh:targetClass": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#Marche"
      }
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b1",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-001 : montant inférieur ou égal à 0"
      },
      "sh:minExclusive": 0,
      "sh:path": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#marche.montant"
      }
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b2",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-002 : durée inférieure ou égale à 0"
      },
      "sh:minExclusive": 0,
      "sh:path": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#marche.dureeMois"
      }
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b3",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-004 : code CPV hors format 8 chiffres-clé"
      },
      "sh:minCount": 1,
      "sh:path": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#marche.codeCPV"
      },
      "sh:pattern": "^[0-9]{8}-[0-9]$"
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b4",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-005 : SIRET acheteur hors format 14 chiffres"
      },
      "sh:minCount": 1,
      "sh:path": {
        "@id": "https://w3id.org/pfd-okdp/uns/def#entite.identifiant.SIRET"
      },
      "sh:pattern": "^[0-9]{14}$"
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b5",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-003 : publication antérieure à la notification"
      },
      "sh:select": "PREFIX uns: <https://w3id.org/pfd-okdp/uns/def#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT $this WHERE { $this uns:marche.datePublicationDonnees ?p ; uns:marche.dateNotification ?n .\n                   FILTER (STR(?p) < STR(?n)) }  # dates AAAA-MM-JJ : ordre des textes = ordre des dates"
    },
    {
      "@id": "_:nffdb20c1696f4cc49fd18d3b621c9531b6",
      "sh:message": {
        "@language": "fr",
        "@value": "MAR-006 : avance attribuée sans taux positif"
      },
      "sh:select": "PREFIX uns: <https://w3id.org/pfd-okdp/uns/def#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT $this WHERE { $this uns:marche.attributionAvance \"1\" .\n                   OPTIONAL { $this uns:marche.tauxAvance ?t } FILTER (!BOUND(?t) || ?t <= 0) }"
    },
    {
      "@id": "https://w3id.org/pfd-okdp/uns/shapes",
